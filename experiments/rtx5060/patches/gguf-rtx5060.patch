diff --git a/dequant_triton.py b/dequant_triton.py
new file mode 100644
index 0000000..6629544
--- /dev/null
+++ b/dequant_triton.py
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: Apache-2.0
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _dequantize_kernel(source, destination, count: tl.constexpr, qtype: tl.constexpr, BLOCK: tl.constexpr):
+    index = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    valid = index < count
+    if qtype == 8:
+        block = index // 32
+        offset = block * 34
+        low = tl.load(source + offset, valid, 0).to(tl.uint16)
+        high = tl.load(source + offset + 1, valid, 0).to(tl.uint16)
+        scale = (low | (high << 8)).to(tl.float16, bitcast=True).to(tl.float32)
+        quant = tl.load(source + offset + 2 + index % 32, valid, 0).to(tl.int8, bitcast=True).to(tl.float32)
+    else:
+        block = index // 256
+        element = index % 256
+        offset = block * 210
+        low = tl.load(source + offset + 208, valid, 0).to(tl.uint16)
+        high = tl.load(source + offset + 209, valid, 0).to(tl.uint16)
+        scale = (low | (high << 8)).to(tl.float16, bitcast=True).to(tl.float32)
+        subgroup_scale = tl.load(source + offset + 192 + element // 16, valid, 0).to(tl.int8, bitcast=True).to(tl.float32)
+        scale = (scale * subgroup_scale).to(tl.float16).to(tl.float32)
+        ql = tl.load(source + offset + (element // 128) * 64 + element % 64, valid, 0).to(tl.int32)
+        qh = tl.load(source + offset + 128 + (element // 128) * 32 + element % 32, valid, 0).to(tl.int32)
+        ql = (ql >> (4 * ((element % 128) // 64))) & 15
+        qh = (qh >> (2 * ((element % 128) // 32))) & 3
+        quant = ((ql | (qh << 4)) - 32).to(tl.float32)
+    result = (scale * quant).to(tl.float16)
+    tl.store(destination + index, result, valid)
+
+
+def dequantize_cuda(tensor, shape, dtype, qtype):
+    output = torch.empty(shape, device=tensor.device, dtype=dtype or torch.float16)
+    _dequantize_kernel[(triton.cdiv(output.numel(), 1024),)](
+        tensor, output, output.numel(), qtype, BLOCK=1024,
+    )
+    return output
